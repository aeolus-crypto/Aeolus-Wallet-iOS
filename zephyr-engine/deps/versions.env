# Dependencies of the iOS engine, built by deps/build_deps.sh. Versions follow what Zephyr's
# Android/Linux builds ship (zephyr-backports' contrib/depends pins: OpenSSL 3.0.22, unbound
# 1.26.1, libsodium 1.0.18, expat 2.6.0, zeromq 4.3.5), except Boost: 1.84.0, the newest Boost
# that upstream Zephyr v2.3.0 builds against unchanged (1.85 removes copy_option, which
# wallet2.cpp uses; 1.87 removes the asio io_service that epee uses).
# Each entry: version, sha256 of the archive, then download URLs tried in order.

BOOST_VERSION=1.84.0
BOOST_FILE=boost_1_84_0.tar.bz2
# sha256 published at https://www.boost.org/users/history/version_1_84_0.html
BOOST_SHA256=cc4b893acf645c9d4b698e9a0f08ca8846aa5d6c68275c14c3e7949c24109454
BOOST_URLS="https://archives.boost.io/release/1.84.0/source/boost_1_84_0.tar.bz2 https://downloads.sourceforge.net/project/boost/boost/1.84.0/boost_1_84_0.tar.bz2"

OPENSSL_VERSION=3.0.22
