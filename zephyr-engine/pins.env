# Source pins. The iOS engine is built from exactly the sources of the Android library that
# Aeolus Wallet ships (dev.lateo:zephyr-java-android:2.3.0-sec.2-java.5): myzephyr-java at its
# java.5 tag, which itself pins zephyr-cpp v2.3.0-sec.1 and zephyr v2.3.0-sec.2 (bin/pins.env
# there) and carries the build-layer patches applied to zephyr's contrib/depends.
MZJ_URL=https://github.com/loki-notfound/myzephyr-java.git
MZJ_TAG=v2.3.0-sec.2-java.5
MZJ_SHA=cb78099ae92a8ff634408cd1df19d6815918ba65

# iOS deployment target (iPhone 6s/SE 1st gen and later run iOS 15)
IOS_MIN_VERSION=15.0
